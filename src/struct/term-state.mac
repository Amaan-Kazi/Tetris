%include "src/struct/color.mac"

%ifndef TERM_STATE_DEFINED
%define TERM_STATE_DEFINED

struc term_state
  .cursorx        resb 2 ; 0 indexed
  .cursory        resb 2 ; 0 indexed

  .background     resb color_size
  .foreground     resb color_size
  .underline      resb color_size

  .flags          resb 1
  .underline_type resb 1
  .padding1       resb 1
endstruc

%endif


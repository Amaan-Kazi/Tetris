%include "src/renderer/terminal/cell/color.mac"

%ifndef CELL_DEFINED
%define CELL_DEFINED

struc cell
  .text           resb 4

  .background     resb color_size
  .foreground     resb color_size
  .underline      resb color_size

  .width          resb 1
  .flags          resb 1
  .underline_type resb 1
endstruc

%endif

